# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# generated by scripts/discover-news-candidates.ts
/scripts/articles.json
/scripts/sourcing-preview.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# python (ingest/)
ingest/.venv/
ingest/__pycache__/
ingest/**/__pycache__/
ingest/*.egg-info/
.ingest_state.json
eval/__pycache__/
eval/.venv/

# route types
/.next-types/

# humanlayer (machine-specific workspace state)
.humanlayer/
